table Settlements
	lineageTag: f5aae29a-8742-48bd-b7eb-fab976c55f57

	/// Total gross settled volume (ZAR) across selected partners and months.
	measure 'Gross Volume' = SUM ( Settlements[gross_volume_zar] )
		formatString: \R#,##0
		displayFolder: 1 Volume
		lineageTag: 4a448a85-e26d-47b7-8a8a-ec0653b435ff

	/// Net amount settled to the bank after merchant and interchange fees.
	measure 'Net Settlement' = SUM ( Settlements[net_settlement_zar] )
		formatString: \R#,##0
		displayFolder: 1 Volume
		lineageTag: 76b1e0cf-ed17-4a4a-9ed6-1d7b65a51aec

	measure 'Total Transactions' = SUM ( Settlements[total_transactions] )
		formatString: #,##0
		displayFolder: 1 Volume
		lineageTag: 709a00a9-e19c-4856-a61b-d23098a411ff

	measure 'Avg Transaction Value' = DIVIDE ( [Gross Volume], [Total Transactions] )
		formatString: \R#,##0.00
		displayFolder: 1 Volume
		lineageTag: e91e594a-911f-4a84-b5ff-8167303f7611

	measure 'Merchant Fees' = SUM ( Settlements[merchant_fees_zar] )
		formatString: \R#,##0
		displayFolder: 2 Economics
		lineageTag: ab42eedb-25ce-48ad-8c4e-b3482d543535

	measure 'Interchange Fees' = SUM ( Settlements[interchange_fees_zar] )
		formatString: \R#,##0
		displayFolder: 2 Economics
		lineageTag: 8a0d03c6-06a6-49ac-96b5-31eebf9f5d0c

	/// Merchant discount rate = merchant fees / gross volume.
	measure 'Effective MDR %' = DIVIDE ( [Merchant Fees], [Gross Volume] )
		formatString: 0.00%
		displayFolder: 2 Economics
		lineageTag: 1213a1a5-c646-4beb-b37b-d927f680bec7

	measure 'Fee Take Rate %' = DIVIDE ( [Merchant Fees] + [Interchange Fees], [Gross Volume] )
		formatString: 0.00%
		displayFolder: 2 Economics
		lineageTag: 0a9a19b2-bdc0-497b-91f1-042572295372

	measure Chargebacks = SUM ( Settlements[chargebacks_count] )
		formatString: #,##0
		displayFolder: 3 Risk
		lineageTag: e67aa30a-93d3-4677-9ed0-e1ae324820f8

	measure 'Chargeback Ratio %' = DIVIDE ( [Chargebacks], [Total Transactions] )
		formatString: 0.00%
		displayFolder: 3 Risk
		lineageTag: dcc14e26-eca9-4b7f-a379-ec219b6ee0d6

	measure 'Active Merchants (Peak)' = MAX ( Settlements[active_merchants] )
		formatString: #,##0
		displayFolder: 3 Risk
		lineageTag: 1a2a13fe-5d04-4a92-9fdc-5c2b1b8708e1

	/// Month-over-month growth in gross volume using month_key ordering.
	measure 'Gross Volume MoM %' = VAR cm = MAX ( Settlements[month_key] ) VAR prev = CALCULATE ( [Gross Volume], FILTER ( ALL ( Settlements[month_key] ), Settlements[month_key] = cm - 1 ) ) RETURN DIVIDE ( [Gross Volume] - prev, prev )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: d1e07e1f-b9dc-4738-8d08-5a1735b6e79f

	measure 'Net Settlement YTD' = CALCULATE ( [Net Settlement], FILTER ( ALL ( Settlements[month_key] ), Settlements[month_key] <= MAX ( Settlements[month_key] ) ) )
		formatString: \R#,##0
		displayFolder: 4 Time Intelligence
		lineageTag: 36526aee-aa3c-4c65-9b10-6c6e9b08706e

	column settlement_id
		isNameInferred
		sourceColumn: [settlement_id]

	column month_key
		isNameInferred
		sourceColumn: [month_key]

	column month_name
		isNameInferred
		sourceColumn: [month_name]
		sortByColumn: month_key

	column fintech_id
		isNameInferred
		sourceColumn: [fintech_id]

	column fintech_name
		isNameInferred
		sourceColumn: [fintech_name]

	column platform_type
		isNameInferred
		sourceColumn: [platform_type]

	column total_transactions
		isNameInferred
		sourceColumn: [total_transactions]

	column gross_volume_zar
		isNameInferred
		sourceColumn: [gross_volume_zar]

	column merchant_fees_zar
		isNameInferred
		sourceColumn: [merchant_fees_zar]

	column interchange_fees_zar
		isNameInferred
		sourceColumn: [interchange_fees_zar]

	column net_settlement_zar
		isNameInferred
		sourceColumn: [net_settlement_zar]

	column chargebacks_count
		isNameInferred
		sourceColumn: [chargebacks_count]

	column chargeback_ratio_pct
		isNameInferred
		sourceColumn: [chargeback_ratio_pct]

	column active_merchants
		isNameInferred
		sourceColumn: [active_merchants]

	column failure_rate_pct
		isNameInferred
		sourceColumn: [failure_rate_pct]

